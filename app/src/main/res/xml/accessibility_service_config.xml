<?xml version="1.0" encoding="utf-8"?>
<!-- Sin canPerformGestures: el servicio no puede tocar la pantalla.
     packageNames limita el servicio a apps de conductor compatibles; en código se filtran las que el conductor desactivó. -->
<accessibility-service xmlns:android="http://schemas.android.com/apk/res/android"
    android:accessibilityEventTypes="typeWindowStateChanged|typeWindowContentChanged|typeViewTextChanged|typeViewScrolled"
    android:accessibilityFeedbackType="feedbackGeneric"
    android:accessibilityFlags="flagIncludeNotImportantViews|flagRetrieveInteractiveWindows"
    android:canRetrieveWindowContent="true"
    android:description="@string/a11y_description"
    android:notificationTimeout="120"
    android:packageNames="com.ubercab.driver,com.didiglobal.driver,com.cabify.driver,sinet.startup.inDriver,ee.mtakso.driver" />
